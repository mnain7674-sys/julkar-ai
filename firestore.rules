rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if true;
      
      // User chats subcollection
      match /chats/{chatId} {
        allow read, write: if true;
      }

      // User settings & subscription subcollections
      match /settings/{settingId} {
        allow read, write: if true;
      }
    }

    // User profiles for personalization engine
    match /user_profiles/{userId} {
      allow read, write: if true;
    }

    // Conversation history
    match /conversation_history/{sessionId} {
      allow read, write: if true;
    }

    // Admin audit logs & telemetry
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Global public configurations or read-only resources
    match /public_config/{configId} {
      allow read, write: if true;
    }

    // Courses collection
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Student Progress collection
    match /studentProgress/{docId} {
      allow read, write: if true;
    }

    // Certificates collection
    match /certificates/{certId} {
      allow read, write: if true;
    }

    // Subscriptions collection
    match /subscriptions/{userId} {
      allow read, write: if true;
    }

    // Practice Projects collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // AI Token Optimization Engine Collections
    match /ai_usage/{id} {
      allow read, write: if true;
    }

    match /ai_cache/{id} {
      allow read, write: if true;
    }

    match /knowledge_base/{id} {
      allow read, write: if true;
    }

    match /conversation_summaries/{id} {
      allow read, write: if true;
    }

    match /optimization_logs/{id} {
      allow read, write: if true;
    }

    match /system_monitoring_logs/{id} {
      allow read, write: if true;
    }

    match /ai_anomalies/{id} {
      allow read, write: if true;
    }

    match /model_usage_stats/{id} {
      allow read, write: if true;
    }

    match /system_config/{id} {
      allow read, write: if true;
    }
  }
}

